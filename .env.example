# Point the UI at the real backend. Leave unset to use the bundled demo
# routes in app/api/* (all demo data is synthetic — see README).
NEXT_PUBLIC_API_BASE=

# Map tile provider. Defaults to CARTO's dark basemap (matches the
# control-room theme) if unset. Swap in any XYZ tile URL — e.g. Mapbox,
# Stadia, or a self-hosted tile server — without touching component code.
NEXT_PUBLIC_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
